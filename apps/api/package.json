{
  "name": "@lna/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:check": "node --env-file-if-exists=.env --import tsx src/db/check.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-database.mjs",
    "test": "tsc -p tsconfig.build.json && node --test scripts/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.3",
    "@supabase/supabase-js": "^2.49.4",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "sharp": "^0.35.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
