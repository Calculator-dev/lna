PORT=4000
# Browser origins allowed to call the API. Defaults to localhost:3000/3001 outside production;
# required in production, e.g. https://lnakreativnasehara.ba,https://crm.lnakreativnasehara.ba
CORS_ORIGINS=
# Behind a reverse proxy/load balancer, set to true (or the number of proxy hops) so rate
# limits apply per client IP rather than per proxy.
TRUST_PROXY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lna_kreativna_sehara
SUPABASE_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use SUPABASE_ANON_KEY instead.
# Backend-only key for trusted user provisioning. Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL is not required: token verification uses Supabase Auth getUser.
BACKBLAZE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKBLAZE_REGION=eu-central-003
BACKBLAZE_KEY_ID=
BACKBLAZE_APP_KEY=
BACKBLAZE_BUCKET_NAME=lna-kreativna-sehara-images
RESEND_API_KEY=
ORDER_EMAIL_FROM=LNA kreativna sehara <narudzbe@your-domain.com>
# Optional: where new custom-work inquiries are emailed (uses the Resend settings above).
INQUIRY_NOTIFY_EMAIL=
# Optional: CRM address used in admin invite links (scripts/invite-admin.mjs). Defaults to http://localhost:3000.
CRM_URL=
